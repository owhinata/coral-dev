# Kconfig fragment for Coral Dev Board (i.MX8MQ Phanbell) on mainline, merged on top of arm64 defconfig
# "-imx" keeps Mendel's usb-gadget-start.sh happy (it matches uname -r against "imx")
CONFIG_LOCALVERSION="-imx-coral"
CONFIG_LOCALVERSION_AUTO=n
# PCIe host (Edge TPU + Wi-Fi are PCIe endpoints)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCI_IMX6_HOST=y
# i.MX8MQ power domains / resets / PHYs
CONFIG_IMX_GPCV2_PM_DOMAINS=y
CONFIG_RESET_IMX7=y
CONFIG_TYPEC=y
CONFIG_PHY_FSL_IMX8MQ_USB=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
# PMIC BD71837
CONFIG_MFD_ROHM_BD718XX=y
CONFIG_REGULATOR_BD718XX=y
CONFIG_COMMON_CLK_BD718XX=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# Storage / network / USB
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_FEC=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# QCA6174 Wi-Fi (module)
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
# Misc board features
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_IMX2_WDT=y
# gasket/apex are built out-of-tree; no module signature enforcement
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
# Type-C CC detection (PTN5150) for dwc3 OTG role switch; USB gadget for mdt networking
CONFIG_EXTCON_PTN5150=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
