From f98cebc00db8ab4e2cd1a03239f857fbc9cf4b28 Mon Sep 17 00:00:00 2001
From: "Katsumi.Ouwa" <d2p.yggdrasill@gmail.com>
Date: Tue, 27 Oct 2026 14:19:05 +0900
Subject: [PATCH 4/7] arm64: dts: imx8mq-phanbell: add PTN5150 Type-C extcon
 for dwc3 OTG role switch

---
 .../boot/dts/freescale/imx8mq-phanbell.dts    | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
index e7d88e4b0..b16ddf8f3 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
@@ -394,8 +394,26 @@ &usb3_phy0 {
 	status = "okay";
 };
 
+/* Type-C CC logic on the OTG port drives dwc3 host/peripheral role switching */
+&i2c3 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c3>;
+	status = "okay";
+
+	typec_ptn5150: typec@3d {
+		compatible = "nxp,ptn5150";
+		reg = <0x3d>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_typec>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
+	};
+};
+
 &usb_dwc3_0 {
 	dr_mode = "otg";
+	extcon = <&typec_ptn5150>;
 	status = "okay";
 };
 
@@ -449,6 +467,19 @@ MX8MQ_IOMUXC_I2C1_SDA_I2C1_SDA			0x4000007f
 		>;
 	};
 
+	pinctrl_i2c3: i2c3grp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_I2C3_SCL_I2C3_SCL			0x4000007f
+			MX8MQ_IOMUXC_I2C3_SDA_I2C3_SDA			0x4000007f
+		>;
+	};
+
+	pinctrl_typec: typecgrp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_NAND_ALE_GPIO3_IO0			0x19
+		>;
+	};
+
 	pinctrl_pcie0: pcie0grp {
 		fsl,pins = <
 			MX8MQ_IOMUXC_I2C4_SCL_PCIE1_CLKREQ_B		0x76
-- 
2.43.0

