diff --git a/src/gasket_core.c b/src/gasket_core.c
index b1c2726..7840c2e 100644
--- a/src/gasket_core.c
+++ b/src/gasket_core.c
@@ -920,9 +920,16 @@ int gasket_mm_unmap_region(const struct gasket_dev *gasket_dev,
 	 *
 	 * Next multiple of y: ceil_div(x, y) * y
 	 */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+	/* zap_vma_ptes() was renamed zap_special_vma_range() in Linux 7.1. */
+	zap_special_vma_range(vma, vma->vm_start + virt_offset,
+			      DIV_ROUND_UP(mappable_region.length_bytes,
+					   PAGE_SIZE) * PAGE_SIZE);
+#else
 	zap_vma_ptes(vma, vma->vm_start + virt_offset,
 		     DIV_ROUND_UP(mappable_region.length_bytes, PAGE_SIZE) *
 		     PAGE_SIZE);
+#endif
 	return 0;
 }
 EXPORT_SYMBOL(gasket_mm_unmap_region);
@@ -1373,7 +1380,6 @@ static long gasket_ioctl(struct file *filp, uint cmd, ulong arg)
 /* File operations for all Gasket devices. */
 static const struct file_operations gasket_file_ops = {
